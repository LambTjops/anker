# Anker configuration. Copy to .env and adjust.

# Time zone used for "today", the day cutoff and display.
TZ_DISPLAY=Pacific/Auckland
# Local time at which an open workday is closed quietly (HH:MM).
DAY_CUTOFF=04:00
# Length of a focus block in minutes.
FOCUS_MINUTES=25

# Name of the Docker network SWAG is on (compose joins it as external).
SWAG_NETWORK=swag
